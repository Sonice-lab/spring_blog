{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><h4 class="mb-0"><b>포인트 충전</b></h4></div>
        <div class="card-body">
            <div class="mb-4">
                <span class="badge bg-primary fs-5"> P</span>
            </div>
            <hr>

            <div class="mb-4">
                <label class="form-label fw-bold mb-3">충전할 포인트 선택</label>
                <!--  이벤트 위임 방식으로 수정 -->
                <div class="row g-3" id="point-btn-group">
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="1000">1,000
                            P
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="5000">5,000
                            P
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="10000">10,000
                            P
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="20000">20,000
                            P
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="50000">50,000
                            P
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="100000">
                            100,000 P
                        </button>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">충전 예정 금액</label>
                <p class="form-control-plaintext">
                    <span class="badge bg-success fs-5" id="selected-amount">0</span> P
                </p>
            </div>

            <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary" id="charge-btn" disabled>충전하기</button>
                <a href="/user/detail" class="btn btn-secondary">취소</a>
            </div>
        </div>
    </div>
</div>
<!-- 포트원 SDK -->
<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>

<script>
    // 준비 - 요소를 다 들어오자.
    let selectedAmount = 0;
    const pointBtns = document.querySelectorAll(".point-btn");
    const amountDisplay = document.querySelector("#selected-amount");
    const chargeBtn = document.querySelector("#charge-btn");

    //이벤트를 등록하는 방법
    // pointBtns.forEach(btn => {
    //     btn.addEventListener("click", function () {
    //         pointBtns.forEach(b => b.classList.remove("active")); // 하나의 버튼이 눌러졌을 때 선택받은 버튼만 활성화처리
    //         this.classList.add("active");
    //         selectedAmount = Number(this.dataset.amount);
    //         amountDisplay.innerText = selectedAmount.toLocaleString();
    //         chargeBtn.disabled = false;
    //     });
    // });

    // 이벤트 위임 (이벤트 전파 속성) - 매커니즘: 부모 하나에만 등록하고, 클릭된 버튼을 찾아서 처리할 수 있음
    document.querySelector("#point-btn-group").addEventListener("click", function (event) {
        // 클릭한 곳에서 가장 가까운 .point-btn 찾기
        const btn = event.target.closest(".point-btn");
        pointBtns.forEach(b => b.classList.remove("active"));

        btn.classList.add("active");
        selectedAmount = Number(btn.dataset.amount);
        amountDisplay.innerText = selectedAmount.toLocaleString();
        chargeBtn.disabled = false;
    });

    // 충전 버튼 클릭 시 -> [1]우리 서버(주문서 생성) [2]포트원 결제창 [3] 결제 완료 처리
    chargeBtn.addEventListener("click", async function () {
        // 방어적코드
        if (selectedAmount <= 0) return;
        chargeBtn.disabled = true; // 중복 클릭 방지

        try {
            // 1단계 - 우리 서버에 결제 건 생성 요청 (paymentId, storeId, channel key 받기)
            const prepareRes = await fetch("/api/payment/prepare", {
                // post 방식으로 던질 것임
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({amount: selectedAmount})
            });
            const prepare = await prepareRes.json(); // JSON ->  JS Object
            if (!prepareRes.ok) {
                alert("잘못된 요청입니다.");
            }

            // 2단계 - 포트원 결제창 호출 (카카오페이 간편 결제 활용)

            const paymentRes = await PortOne.requestPayment({
                storeId: prepare.storeId,
                channelKey: prepare.channelKey,
                paymentId: prepare.paymentId,
                orderName: "포인트 충전",
                totalAmount: prepare.amount,
                currency: "CURRENCY_KRW",
                payMethod: "EASY_PAY",
            });

            console.log(paymentRes);
            // 결제 실패나 취소시 응답에 code가 들어있음
            if (!paymentRes || paymentRes.code != undefined) {
                alert("결제가 완료되지 않았습니다.")
            }

            // 3단계 서버 검증 요청 (우리 서버에서 포트원 서버로 직접 HTTP 통신 후 정상적인 부분인지 확인 후 포인트 충전 진행)
            const completeRes = await fetch("/api/payment/complete", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({paymentId: paymentRes.paymentId})
            });

            const result = await completeRes.json();
            if (!completeRes.ok) {
                alert("포인트 충전에 실패했습니다.")
            }

            // 여기까지 코드가 내려온다면 성공!
            // 안내문구 alert()
            alert("충전이 완료되었습니다.\n충전금액: "
                    + result.amount.toLocaleString()
                    + "\n현재 보유 포인트: " + result.currentPoint);

            location.href = "/user/detail";
        } catch (e) {
            alert(e.message + ": 서버와 통신하지 못했습니다.")
        } finally {
            chargeBtn.disabled = false;
        }

    });


</script>

{{> layout/footer}}