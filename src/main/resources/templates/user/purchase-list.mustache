{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><b>구매 내역</b></h4>
        </div>
        <div class="card-body p-4">

            {{! 구매 내역이 있는 경우 }}
            {{#purchaseList}}
                <div class="card mb-4 shadow-sm">
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <!-- 제목 -->
                            <h5 class="mb-2">
                                <a href="/board/{{board.id}}" class="text-primary text-decoration-none">{{board.title}}</a>
                            </h5>
                            <!-- 작성자 및 구매일 정보 -->
                            <div class="text-muted" style="font-size: 0.95rem;">
                                <div class="mb-1">
                                    <i class="bi bi-person-fill"></i> 작성자: {{board.user.username}}
                                </div>
                                <div>
                                    <i class="bi bi-calendar-check"></i> 구매일: {{time}}
                                </div>
                            </div>
                        </div>
                        <!-- 포인트 차감 뱃지 -->
                        <div>
                            <span class="badge bg-primary fs-6 px-3 py-2">-{{price}} P</span>
                        </div>
                    </div>
                </div>
            {{/purchaseList}}

            {{! 구매 내역이 없는 경우 (빈 화면) }}
            {{^purchaseList}}
                <div class="text-center my-5 py-5">
                    <!-- 장바구니 아이콘 -->
                    <i class="bi bi-cart-fill text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="mt-4 mb-2">구매 내역이 없습니다</h4>
                    <p class="text-muted mb-4">유료 게시글을 구매해보세요!</p>
                    <a href="/board/list" class="btn btn-primary px-4 py-2">게시글 목록으로</a>
                </div>
            {{/purchaseList}}

            <!-- 하단 돌아가기 버튼 -->
            <div class="mt-5">
                <a href="/user/detail" class="btn btn-secondary px-4 py-2">회원정보로 돌아가기</a>
            </div>

        </div>
    </div>
</div>

{{> layout/footer}}