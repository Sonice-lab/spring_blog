{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>회원가입</b></div>
        <div class="card-body">
            <!-- 파일을 보내려면 enctype을 반드시 Multipart/form-data 이어야 함 -->
            <form action="/join" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="사용자명" name="username">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="비밀번호" name="password">
                </div>
                <div class="mb-3">
                    <input type="email" class="form-control" placeholder="이메일" name="email">
                </div>
                <div class="mb-3">
                    <input type="file" class="form-control" id="profileImage" name="profileImage" accept="image/**">
                    <small>JPG, PNG, GIF, WEBP 파일만 올릴 수 있습니다.(선택사항)</small>
                </div>
                <button class="btn btn-primary form-control">회원가입</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}