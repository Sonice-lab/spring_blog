{{>layout/header}}

<div class="error-page-wrapper">
    <div class="container p-5 error-card">

        <!-- 끊어진 파일 아이콘 (찾을 수 없음) -->
        <div class="mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#6c757d" class="bi bi-file-earmark-x" viewBox="0 0 16 16">
                <path d="M6.854 7.146a.5.5 0 1 0-.708.708L7.293 9l-1.147 1.146a.5.5 0 0 0 .708.708L8 9.707l1.146 1.147a.5.5 0 0 0 .708-.708L8.707 9l1.147-1.146a.5.5 0 0 0-.708-.708L8 8.293 6.854 7.146z"/>
                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
            </svg>
        </div>

        <h1 style="color: #6c757d;">NotFound 404</h1>
        <hr class="my-4 text-muted">

        <h3 class="error-msg mb-4">{{msg}}</h3>
        <p class="text-muted mb-4">요청하신 페이지가 존재하지 않거나 삭제되었습니다.</p>

        <div class="mt-4 error-btn-group">
            <a href="/" class="btn btn-primary">메인페이지</a>
        </div>

    </div>
</div>

{{> layout/footer}}