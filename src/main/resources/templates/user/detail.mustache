{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>마이페이지</b></div>
        <div class="card-body">
            <div class="text-center mb-4">
                {{! 프로필 이미지가 있을 경우}}
                {{#user.profileImage}}
                    <img src="{{user.profileImage}}" alt="" class="rounded-circle border"
                         style="width: 200px; height: 200px; object-fit: cover">
                {{/user.profileImage}}
                {{! 프로필 이미지가 없을 경우}}
                {{^user.profileImage}}
                    <div class="rounded-circle border bg-secondary d-inline-flex align-items-center justify-content-center"
                         style="width: 200px; height: 200px;">
                        <span class="text-white">프로필 사진 없음</span>
                    </div>
                {{/user.profileImage}}
            </div>

            <div class="mb-3">
                <label for="" class="form-label fw-bold">사용자명</label>
                <p class="form-control-plaintext">{{user.username}}</p>
            </div>

            <div class="mb-3">
                <label for="" class="form-label fw-bold">이메일</label>
                <p class="form-control-plaintext">{{user.email}}</p>
            </div>

            <!-- 👇 새로 추가된 휴대폰 인증 상태 영역 -->
            <div class="mb-3">
                <label for="" class="form-label fw-bold">휴대폰 인증 상태</label>
                <div>
                    {{#user.phoneNumber}}
                        <span class="badge bg-success text-white p-2">✅ 인증 완료 ({{user.phoneNumber}})</span>
                    {{/user.phoneNumber}}

                    {{^user.phoneNumber}}
                        <span class="badge bg-secondary text-white p-2 mb-2">미인증</span>
                        <br>
                        <a href="/user/sms-verify" class="btn btn-sm btn-outline-dark mt-1">휴대폰 인증하기</a>
                    {{/user.phoneNumber}}
                </div>
            </div>
            <!-- 👆 새로 추가된 영역 끝 -->

            <div class="mb-3">
                <label for="" class="form-label fw-bold">가입일</label>
                <p class="form-control-plaintext">{{user.createdAt}}</p>
            </div>

            <div class="mb-3 mt-4">
                <a href="/user/update" class="btn btn-primary">회원 정보 수정</a>
                <!-- 하단에 중복되던 휴대폰 인증 버튼은 위쪽 영역으로 이동하여 제거했습니다 -->
                <a href="/" class="btn btn-secondary">목록으로</a>
            </div>

        </div>
    </div>
</div>

{{> layout/footer}}